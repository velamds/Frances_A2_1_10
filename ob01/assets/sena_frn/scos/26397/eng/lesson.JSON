t": "", "type": "text"}], "id": 0, "correct": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "frn4le10ob01re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Trouvez une liste des  meilleurs endroits au monde o\u00f9 on peut faire de la plong\u00e9e.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Consignes : Compl\u00e9tez les \u00e9tapes suivantes. Remplissez la grille d'auto-\u00e9valuation.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 2, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "frn4le10ob01re2aud01", "coverimg": "frn4le10ob01re2img01.jpg", "images": [{"image": "frn4le10ob01re2img01.jpg", "text": "", "id": 0, "time": "0"}, {"image": "frn4le10ob01re2img01.jpg", "text": "<span class=\"strong\">L'instructeur de plong\u00e9e</span> : Bienvenue \u00e0  La Plong\u00e9e de Basse-Californie. <br/>", "id": 1, "time": "100"}, {"image": "frn4le10ob01re2img05.jpg", "text": "<span class=\"strong\">Jean</span> :  Merci. J'h\u00e9site entre faire de la plong\u00e9e libre ou de la plong\u00e9e sous-marine. Qu'est-ce qui serait le mieux ?", "id": 2, "time": "3000"}, {"image": "frn4le10ob01re2img01.jpg", "text": "<span class=\"strong\">L'instructeur de plong\u00e9e</span> : Vous pourriez essayer les deux ! Quand on a l'\u00e9quipement appropri\u00e9 et la formation, les deux sont s\u00fbrs et divertissants.  Aimeriez-vous nager en eau profonde, dans l'oc\u00e9an&nbsp;?<br/> <span class=\"strong\">Jean</span> : Euh... oui, pourquoi pas ? <br/>", "id": 3, "time": "9000"}, {"image": "frn4le10ob01re2img02.jpg", "text": "<span class=\"strong\">L'instructeur de plong\u00e9e</span> : Dans ce cas, faites de la plong\u00e9e sous-marine. Vous devriez plonger dans les aires d'alimentation de la p\u00e9ninsule de Baja. Ce sont les meilleurs endroits pour voir les requins et les raies mantas.<br/><span class=\"strong\">Jean</span> : Quoi ? Les requins ? Ce ne serait pas un peu dangereux ?", "id": 4, "time": "21200"}, {"image": "frn4le10ob01re2img03.jpg", "text": "<span class=\"strong\">L'instructeur de plong\u00e9e</span> :  Ne vous inqui\u00e9tez pas. Les requins n'attaquent pas les humains. Utilisez le matos appropri\u00e9 et prenez une le\u00e7on avec un excellent instructeur. Nous avons les meilleurs instructeurs de la r\u00e9gion. N'oubliez pas d'apporter un appareil photo \u00e9tanche !  C'est mieux pour ne pas louper vos photos !  Vous pouvez commencer \u00e0 faire de la plong\u00e9e libre cet apr\u00e8s-midi m\u00eame.<br/>\n<span class=\"strong\">Jean</span> : Fantastique !", "id": 5, "time": "35200"}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Jean au Mexique ", "type": "lesson_name"}, {"content": "La plong\u00e9e en Basse-Californie", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "scholar > Celebrating Important Occasions > Day of the Dead", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "L'apprenant fait usage d'une information pr\u00e9cise concernant les voyages et les vacances dans des situations sociales. ", "type": "primary"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral concernant des conseils pour avoir une vie saine. ", "type": "secondary_1"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral concernant des conseils pour avoir une vie saine. ", "type": "secondary_2"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral concernant des conseils pour avoir une vie saine. ", "type": "secondary_3"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral concernant des conseils pour avoir une vie saine. ", "type": "secondary_4"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral concernant des conseils pour avoir une vie saine. ", "type": "secondary_5"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral concernant des conseils pour avoir une vie saine. ", "type": "secondary_6"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral concernant des conseils pour avoir une vie saine. ", "type": "secondary_7"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral concernant des conseils pour avoir une vie saine. ", "type": "secondary_8"}]}, {"content": "frn4le10ob01re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "La diff\u00e9rence entre mieux et meilleur. ", "type": "heading"}, {"content": "<span class=\"strong\">Mieux </span> est un adverbe et le comparatif de bien. <span class=\"strong\">Meilleur</span>  est un adjectif et le comparatif de bon.", "type": "describer"}, {"content": "{\"rows\":9,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Mieux\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meilleur, meilleure, meilleurs, meilleures\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Yohann nage bien mais Thierry nage mieux. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" La cuisine de ma m\u00e8re est bonne mais celle de ma grand-m\u00e8re est meilleure !\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Flotter c'est bien. Nager c'est mieux. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Louis a un bon appareil photo mais Robert en a un meilleur. \\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "C'est mieux pour ne pas louper vos photos ! ", "type": "example"}, {"content": " Ce sont les meilleurs endroits pour voir les requins et les raies mantas.", "type": "example"}]}, {"type": "target_word_describer", "contents": [{"content": "Voici des mots qu'on utilise pour parler de la plong\u00e9e sous-marine.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "plonger", "type": "name"}, {"content": "descendre vers le fond de l'eau", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple :  Vous pouvez plonger cet apr\u00e8s-midi.", "type": "example"}, {"content": "frn4le10ob01aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "le requin", "type": "name"}, {"content": "animal marin dangereux aux dents impressionnantes ", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : Dans la p\u00e9ninsule de Baja, il y a des requins", "type": "example"}, {"content": "frn4le10ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "appropri\u00e9, appropri\u00e9e", "type": "name"}, {"content": "ad\u00e9quat, convenable", "type": "definition"}, {"content": "(adjectif)", "type": "part_speech"}, {"content": "Exemple : Quand on a l'\u00e9quipement appropri\u00e9 et la formation, la plong\u00e9e est s\u00fbre et divertissante.  ", "type": "example"}, {"content": "frn4le10ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "la raie manta", "type": "name"}, {"content": "animal marin de forme large et plate ", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : Ce sont les meilleurs endroits pour voir les requins et les raies mantas.", "type": "example"}, {"content": "frn4le10ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "la p\u00e9ninsule", "type": "name"}, {"content": "r\u00e9gion qui s'avance dans l'oc\u00e9an ou la mer", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple :  Vous devriez plonger dans les aires d'alimentation de la p\u00e9ninsule de Baja. ", "type": "example"}, {"content": "frn4le10ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "attaquer", "type": "name"}, {"content": "\u00eatre \u00e0 l'origine d'un combat", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple : Les requins n'attaquent pas les humains.", "type": "example"}, {"content": "frn4le10ob01aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "la plong\u00e9e libre", "type": "name"}, {"content": "aller dans la mer sans l'\u00e9quipement pour observer les poissons", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : J'h\u00e9site entre faire de la plong\u00e9e libre ou de la plong\u00e9e sous-marine.", "type": "example"}, {"content": "frn4le10ob01aud07", "type": "audio"}]}, {"type": "learning_points", "contents": [{"content": "Exprimer l'incertitude", "type": "heading"}, {"content": "On utilise le conditionnel pr\u00e9sent, souvent  la forme interrogative, pour exprimer une \u00e9ventualit\u00e9 ou pour faire des demandes polies.", "type": "describer"}, {"content": "<span class=\"strong\">L'instructeur de plong\u00e9e</span> : Aimeriez-vous nager en eaux profondes, dans l'oc\u00e9an ? </br> <span class=\"strong\">Jean</span> : Les requins ? Ce ne serait pas un peu dangereux ?", "type": "example"}]}, {"type": "takeaway_extension", "contents": [{"content": "Trouvez des informations en ligne sur les endroits dans le monde o\u00f9 vous pouvez faire de la plong\u00e9e sous-marine ou de la plong\u00e9e libre. ", "type": "text"}, {"content": "Trouvez des endroits sur diff\u00e9rents continents.", "type": "text"}, {"content": "\u00c9crivez une liste de 10 endroits. ", "type": "text"}, {"content": "Avec un camarade, choisissez les 5 meilleurs endroits que vous aimeriez visiter.", "type": "text"}, {"content": "Discutez pourquoi vous avez choisi ces endroits. Utilisez \"le plus\" pour construire vos phrases. ", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "J'identife d'autres endroits dans le monde.", "type": "text"}, {"content": "Je fais une liste d'autres endroits dans le monde.", "type": "text"}, {"content": "Je discute de mes pr\u00e9f\u00e9rences.", "type": "text"}, {"content": "Je fais des choix bas\u00e9s sur mes pr\u00e9f\u00e9rences.", "type": "text"}]}]}